# Resend API key for inquiry form emails (optional — form still works without it, logs to console)
# Get one at https://resend.com
RESEND_API_KEY=

# Sender email (must be verified domain in Resend)
RESEND_FROM_EMAIL=KIC Website <noreply@yourdomain.com>

# Recipient for inquiry notifications (defaults to c.clulow@innovationcity.rw)
INQUIRY_TO_EMAIL=c.clulow@innovationcity.rw
